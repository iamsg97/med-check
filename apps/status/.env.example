# Copy to .env.local for local development.
#
# 1. Create a GitHub OAuth App: https://github.com/settings/applications/new
#      Homepage URL:               http://localhost:4100
#      Authorization callback URL: http://localhost:4100/auth/callback
# 2. Paste the generated Client ID and Client Secret below.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub username(s) allowed to sign in (comma-separated). Everyone else is
# rejected right after GitHub confirms their identity — no session is created.
GITHUB_ALLOWED_LOGIN=iamsg97

# Optional overrides
PORT=4100
# Must match the callback URL registered on the OAuth App above.
BASE_URL=http://localhost:4100
# How long a signed-in session lasts before GitHub sign-in is required again.
SESSION_TTL_HOURS=12
