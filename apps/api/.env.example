# Copy to .env.local for local development.

PORT=3000

# Transport used to reach the Lambda compute layer.
#   http = forward to each Lambda's local dev server (local default)
#   aws  = real Lambda InvokeCommand
LAMBDA_INVOKER=http

# --- LAMBDA_INVOKER=http ---
LAMBDA_URL_MEDICINE_SERVICE=http://localhost:4000

# --- LAMBDA_INVOKER=aws ---
# AWS_REGION=ap-south-1
# LAMBDA_NAME_MEDICINE_SERVICE=med-check-medicine-service
# LAMBDA_NAME_AI_ENRICHMENT=med-check-ai-enrichment
# LAMBDA_NAME_SYMPTOM_SEARCH=med-check-symptom-search
# LAMBDA_NAME_NOTIFICATION_SERVICE=med-check-notification-service

# Auth. Runs every request as DEV_USER_ID — local development only.
# Leave unset (or not "true") in any deployed stage; requests then 401 until
# Cognito JWT verification is wired up.
ALLOW_DEV_USER=true
DEV_USER_ID=dev-user

# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
